{
	"schema_version": "2.2",
	"description": "政治疆域：城市 power=发展度；半径随发展度；城格+视觉辖区锁定；中立城弱源不可吸收；关隘弱源。演武与大地图共用本算法。",
	"map_width": 100,
	"map_height": 70,
	"mode": "influence",
	"city_power": {
		"development_scale": 1.0,
		"_comment": "政治影响力 = 运行时发展度 × development_scale（发展度为城市综合实力唯一 power 源）"
	},
	"radius": {
		"min": 2,
		"max": 7,
		"per_development": 20,
		"_comment": "radius = clamp(min + floor(development/per_development), min, max)"
	},
	"ownership_threshold": 25,
	"dominance_ratio": 1.25,
	"frontier_min_score": 12,
	"hole_fill_neighbor_count": 5,
	"hole_fill_rounds": 3,
	"city_cell_lock": true,
	"core_boost": 1.35,
	"neutral_city_protected": true,
	"pass": {
		"as_source": true,
		"power": 10,
		"radius": 2,
		"owner_multiplier": 1.6,
		"enemy_multiplier": 0.5,
		"lock_self": true,
		"neutral_multiplier": 0.35,
		"adjacent_owner_bonus": 0.2
	},
	"terrain_influence": {
		"plains": 1.0,
		"forest": 0.85,
		"hill": 0.7,
		"marsh": 0.6,
		"river": 0.55,
		"mountain": 0.35,
		"desert": 0.5,
		"tundra": 0.5,
		"deepsea": 0.0,
		"shallowsea": 0.3,
		"deep_ocean": 0.0,
		"shallow_ocean": 0.3,
		"pass": 1.0,
		"ford": 0.9
	},
	"bordering": {
		"max_hex_distance": 1
	},
	"border_friction": {
		"base_chance": 0.03,
		"per_border_edge": 0.002,
		"opinion_threshold": 0
	},
	"derived_radius_rules": {
		"level_radii": {
			"1": 4,
			"2": 5,
			"3": 6,
			"4": 7,
			"5": 8
		},
		"capital_bonus_radius": 2,
		"development_bonus_threshold": 50,
		"development_bonus_radius": 1,
		"neutral_radius": 2
	},
	"overrides": []
}
